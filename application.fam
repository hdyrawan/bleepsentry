# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="bleepsentry",  # Must be unique
    name="Bleepsentry",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="bleepsentry_app",
    stack_size=2 * 1024,
    sources=["*.c*", "!tests"],
    fap_category="Sub-GHz",
    fap_version="0.6",
    fap_icon="bleepsentry.png",  # 10x10 1-bit PNG
    fap_description="Passive RF anomaly sentry for red-team recon and TSCM bug sweeps",
    fap_author="hdyrawan",
    fap_weburl="https://github.com/hdyrawan/bleepsentry",
    fap_icon_assets="images",  # Image assets to compile for this application
)
